echo "$(date +%T) e3_p256_mpi_r3"
( mpirun -np 256 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:64:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=1 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --steps 15 --allreduce mpi --alltoall mpi --a2a-wait --exp E3 ) > results/raw/E3/e3_p256_mpi_r3.log 2>&1 || echo "FAILED e3_p256_mpi_r3"
