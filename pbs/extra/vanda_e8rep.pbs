#!/bin/bash
# Repetitions of the four 256-core ranks x threads splits (E8), three more runs
# each, interleaved, on the same four cn nodes as P256CN and E3REP (plan D14).
#PBS -N E8REP
#PBS -P <project>
#PBS -l select=1:ncpus=72:mpiprocs=72:mem=480gb:host=cn-066+1:ncpus=72:mpiprocs=72:mem=480gb:host=cn-143+1:ncpus=72:mpiprocs=72:mem=480gb:host=cn-146+1:ncpus=72:mpiprocs=72:mem=480gb:host=cn-156
#PBS -l walltime=00:30:00
#PBS -l place=scatter:excl
#PBS -j oe
#PBS -o results/raw/E8/E8REP.job.log

cd "$PBS_O_WORKDIR"
module load gompi/2023a > /dev/null 2>&1
echo "job $PBS_JOBID on $(sort -u "$PBS_NODEFILE" | tr '\n' ' ')"
echo "$(date +%T) e8_256_r128_t2_r1"
( mpirun -np 128 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:32:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=2 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r128_t2_r1.log 2>&1 || echo "FAILED e8_256_r128_t2_r1"
echo "$(date +%T) e8_256_r256_t1_r1"
( mpirun -np 256 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:64:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=1 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r256_t1_r1.log 2>&1 || echo "FAILED e8_256_r256_t1_r1"
echo "$(date +%T) e8_256_r32_t8_r1"
( mpirun -np 32 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:8:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=8 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r32_t8_r1.log 2>&1 || echo "FAILED e8_256_r32_t8_r1"
echo "$(date +%T) e8_256_r64_t4_r1"
( mpirun -np 64 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:16:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=4 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r64_t4_r1.log 2>&1 || echo "FAILED e8_256_r64_t4_r1"
echo "$(date +%T) e8_256_r128_t2_r2"
( mpirun -np 128 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:32:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=2 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r128_t2_r2.log 2>&1 || echo "FAILED e8_256_r128_t2_r2"
echo "$(date +%T) e8_256_r256_t1_r2"
( mpirun -np 256 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:64:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=1 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r256_t1_r2.log 2>&1 || echo "FAILED e8_256_r256_t1_r2"
echo "$(date +%T) e8_256_r32_t8_r2"
( mpirun -np 32 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:8:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=8 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r32_t8_r2.log 2>&1 || echo "FAILED e8_256_r32_t8_r2"
echo "$(date +%T) e8_256_r64_t4_r2"
( mpirun -np 64 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:16:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=4 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r64_t4_r2.log 2>&1 || echo "FAILED e8_256_r64_t4_r2"
echo "$(date +%T) e8_256_r128_t2_r3"
( mpirun -np 128 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:32:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=2 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r128_t2_r3.log 2>&1 || echo "FAILED e8_256_r128_t2_r3"
echo "$(date +%T) e8_256_r256_t1_r3"
( mpirun -np 256 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:64:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=1 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r256_t1_r3.log 2>&1 || echo "FAILED e8_256_r256_t1_r3"
echo "$(date +%T) e8_256_r32_t8_r3"
( mpirun -np 32 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:8:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=8 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r32_t8_r3.log 2>&1 || echo "FAILED e8_256_r32_t8_r3"
echo "$(date +%T) e8_256_r64_t4_r3"
( mpirun -np 64 --mca pml ob1 --mca btl self,vader,tcp --map-by ppr:16:node --bind-to none -x OMP_PROC_BIND=false -x OMP_NUM_THREADS=4 build/vanda-float/mlp_parallel --data synthetic --experts 16 --capacity 2.0 --batch 16384 --load results/ckpt/moe_E16_H512_F1024_L2.bin --a2a-wait --steps 15 --exp E8 ) > results/raw/E8/e8_256_r64_t4_r3.log 2>&1 || echo "FAILED e8_256_r64_t4_r3"
echo "$(date +%T) done"
